rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Requests must be discoverable by signed-in providers, but their owner
    // cannot be impersonated or changed from a client.
    match /requests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.customer_uid == request.auth.uid;
      allow update: if signedIn() && resource.data.customer_uid == request.auth.uid
        && request.resource.data.customer_uid == resource.data.customer_uid;
      allow delete: if signedIn() && resource.data.customer_uid == request.auth.uid;
    }

    match /offers/{id} {
      allow create: if signedIn() && request.resource.data.provider_uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.provider_uid == request.auth.uid ||
        get(/databases/$(database)/documents/requests/$(resource.data.request_id)).data.customer_uid == request.auth.uid);
      allow update: if signedIn() && resource.data.provider_uid == request.auth.uid
        && request.resource.data.provider_uid == resource.data.provider_uid;
      allow delete: if signedIn() && resource.data.provider_uid == request.auth.uid;
    }

    match /orders/{id} {
      function participant(data) { return data.customer_uid == request.auth.uid || data.provider_uid == request.auth.uid; }
      allow read: if signedIn() && participant(resource.data);
      allow create, update: if signedIn() && participant(request.resource.data)
        && ( !exists(/databases/$(database)/documents/orders/$(id)) || participant(resource.data));
      allow delete: if signedIn() && participant(resource.data);
      match /reviews/{role} {
        allow read: if signedIn() && participant(get(/databases/$(database)/documents/orders/$(id)).data)
          && get(/databases/$(database)/documents/orders/$(id)).data.reviews_visible == true;
        allow write: if false;
      }
    }

    match /problem_tickets/{id} {
      allow read: if signedIn() && resource.data.reporter_uid == request.auth.uid;
      allow write: if false;
    }

    match /chats/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participant_uids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participant_uids;
      allow update: if signedIn() && request.auth.uid in resource.data.participant_uids
        && request.auth.uid in request.resource.data.participant_uids;
      allow delete: if signedIn() && request.auth.uid in resource.data.participant_uids;
    }

    match /cleaning_jobs/{id} {
      function isParticipant() {
        return exists(/databases/$(database)/documents/orders/$(id)) &&
          (get(/databases/$(database)/documents/orders/$(id)).data.customer_uid == request.auth.uid ||
           get(/databases/$(database)/documents/orders/$(id)).data.provider_uid == request.auth.uid);
      }
      allow read, create, update: if signedIn() && isParticipant();
      allow delete: if signedIn() && isParticipant();
    }

    // An apartment owner controls only their own reusable room-by-room list.
    match /cleaning_checklist_templates/{id} {
      allow read, delete: if signedIn() && resource.data.owner_uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow update: if signedIn() && resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == resource.data.owner_uid;
    }

    // Academy learning materials are publicly readable. Only the publishing
    // pipeline/admin should write the canonical questions and answer keys.
    match /academy_modules/{id} { allow read: if true; allow write: if false; }
    match /academy_lessons/{id} { allow read: if true; allow write: if false; }
    match /academy_questions/{id} { allow read: if true; allow write: if false; }

    match /academy_progress/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    // Official attempts are created exclusively by the Cloud Function.
    match /academy_exam_attempts/{attemptId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
