rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    // Both order participants can view cleaning proof; only its uploader can
    // create it.  This prevents an unrelated authenticated user from reading
    // a property's photos.
    match /cleaning_evidence/{uid}/{orderId}/{allPaths=**} {
      function orderParticipant() {
        return exists(/databases/(default)/documents/orders/$(orderId)) &&
          request.auth.uid in [
            get(/databases/(default)/documents/orders/$(orderId)).data.customer_uid,
            get(/databases/(default)/documents/orders/$(orderId)).data.provider_uid
          ];
      }
      allow read: if signedIn() && orderParticipant();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /chat_media/{uid}/{threadId}/{allPaths=**} {
      function chatParticipant() {
        return exists(/databases/(default)/documents/chats/$(threadId)) &&
          request.auth.uid in get(/databases/(default)/documents/chats/$(threadId)).data.participant_uids;
      }
      allow read: if signedIn() && chatParticipant();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
